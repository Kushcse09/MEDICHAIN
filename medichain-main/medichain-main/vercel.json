{
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": "@medichain_api_url",
    "NEXT_PUBLIC_CONTRACT_ADDRESS": "@medichain_contract_address",
    "NEXT_PUBLIC_POLYGON_AMOY_RPC": "@medichain_amoy_rpc"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
